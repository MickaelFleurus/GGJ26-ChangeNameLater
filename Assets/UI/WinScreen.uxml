<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UI-style.uss?fileID=7433441132597879392&amp;guid=e1775db2a13d744f789b0a5779c7137c&amp;type=3#UI-style"/>
    <ui:Image style="position: absolute; background-image: resource(&quot;MainScreen&quot;); background-color: rgb(0, 0, 0); width: 1920px; height: 1080px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.47);"/>
    <ui:Label text="You survived" name="Win" emoji-fallback-support="false" enable-rich-text="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="credit_title" style="font-size: 85px; text-shadow: 2px 2px 0 rgb(0, 0, 0);"/>
    <ui:VisualElement name="Content" style="flex-grow: 1; left: 87px; height: 924px; width: 1698px;">
        <ui:Label text="You left the house after {}." name="Time" enable-rich-text="false" emoji-fallback-support="false" triple-click-selects-line="false" double-click-selects-word="false" display-tooltip-when-elided="false" class="option_font" style="margin-bottom: 50px;"/>
        <ui:Label text="You collected loot worth {} €." name="Amount" enable-rich-text="false" emoji-fallback-support="false" triple-click-selects-line="false" double-click-selects-word="false" display-tooltip-when-elided="false" class="option_font" style="margin-bottom: 50px;"/>
        <ui:Label text="Will you dare to go back and try to do better?" name="Challenge" enable-rich-text="false" emoji-fallback-support="false" triple-click-selects-line="false" double-click-selects-word="false" display-tooltip-when-elided="false" class="option_font" style="margin-bottom: 86px;"/>
    </ui:VisualElement>
    <ui:Label text="Press Enter to try again, Escape to quit" name="Label" enable-rich-text="false" emoji-fallback-support="false" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" class="option_font" style="bottom: 48px; align-items: center; align-self: center;"/>
</ui:UXML>
