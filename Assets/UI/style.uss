:root {
}

.ui_hud_hints {
    -unity-font-definition: url("project://database/Assets/Fonts/Essays1743.ttf?fileID=12800000&guid=c6718651f693a4b3581d0ec264576db5&type=3#Essays1743");
    opacity: 0.07;
    font-size: 50px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(185, 153, 153, 0.38);
    text-shadow: 1px 1px 0 rgb(255, 255, 255);
}

.ui_HUD_collected {
    background-color: rgba(0, 0, 0, 0.27);
    background-size: 100% 100%;
    border-bottom-width: 2px;
    border-right-width: 2px;
    position: absolute;
    font-size: 57px;
    -unity-text-align: upper-left;
}

.hidden {
    display: none;
}

.title {
    -unity-font-definition: url("project://database/Assets/Fonts/Essays1743.ttf?fileID=12800000&guid=c6718651f693a4b3581d0ec264576db5&type=3#Essays1743");
    font-size: 214px;
    text-shadow: 3px 3px 5px rgb(255, 255, 255);
    letter-spacing: 7px;
    word-spacing: 0;
}

.unity-button {
    width: 200px;
    min-width: 150px;
    max-width: 210px;
    height: 70px;
    min-height: 70px;
    max-height: 75px;
    margin-top: 0;
    margin-bottom: 15px;
    background-position-y: center;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 1;
    -unity-slice-top: 1;
    -unity-slice-right: 1;
    -unity-slice-bottom: 1;
    background-color: rgba(255, 255, 255, 0);
    background-position-x: center;
    background-size: 100% 100%;
    background-image: none;
    border-top-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-bottom-left-radius: 9px;
    transform-origin: center;
    translate: 0% 0;
    scale: 1 1;
}

.unity-button:focus {
    -unity-background-image-tint-color: rgba(217, 175, 83, 0);
    color: rgba(236, 170, 79, 0.8);
}

.unity-button:disabled {
    opacity: 0.5;
    pointer-events: none;
}

.title_screen_button {
    align-items: flex-start;
    justify-content: flex-start;
    align-self: auto;
    align-content: flex-start;
    top: 0;
}

.title_screen_buttons_parent {
    flex-direction: row;
    justify-content: center;
    align-content: center;
}

.title_screen_panel {
    width: 85%;
    height: 590px;
    position: absolute;
    top: 290px;
    align-self: center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(84, 84, 84);
    border-right-color: rgb(84, 84, 84);
    border-top-color: rgb(84, 84, 84);
    border-bottom-color: rgb(84, 84, 84);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(0, 0, 0, 0.45);
    align-items: center;
}

.option_item {
    align-items: center;
    align-self: center;
    width: 90%;
    height: 77px;
}

.item_text_style {
    -unity-font-definition: url("project://database/Assets/Fonts/RomanAntique.ttf?fileID=12800000&guid=da82319c098414b33a4abd317aa3fb2e&type=3#RomanAntique");
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    justify-content: space-between;
    align-self: center;
    align-content: flex-start;
    align-items: stretch;
}

.unity-base-slider__label {
    width: 50%;
    -unity-text-align: middle-left;
}

.unity-toggle__label {
    width: 50%;
    -unity-text-align: middle-left;
}

.unity-group-box__label {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/RomanAntique.ttf?fileID=12800000&guid=da82319c098414b33a4abd317aa3fb2e&type=3#RomanAntique");
    font-size: 60px;
    -unity-text-align: upper-center;
    -unity-font-style: normal;
    margin-bottom: 70px;
    text-shadow: 3px 3px 0 rgb(0, 0, 0);
}

.credit_text {
    -unity-font-definition: url("project://database/Assets/Fonts/RomanAntique.ttf?fileID=12800000&guid=da82319c098414b33a4abd317aa3fb2e&type=3#RomanAntique");
    color: rgb(255, 255, 255);
    font-size: 30px;
    margin-bottom: 10px;
    align-self: center;
    align-items: center;
    -unity-text-align: middle-center;
}

.unity-group-box {
    width: 100%;
}

.options_controls_row {
    width: 95%;
    flex-direction: row;
}

.credit_title {
    -unity-font-definition: url("project://database/Assets/Fonts/Essays1743.ttf?fileID=12800000&guid=c6718651f693a4b3581d0ec264576db5&type=3#Essays1743");
    font-size: 45px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    margin-bottom: 25px;
}

.credit_section {
    color: rgb(218, 240, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/RomanAntique.ttf?fileID=12800000&guid=da82319c098414b33a4abd317aa3fb2e&type=3#RomanAntique");
    font-size: 35px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.unity-button:hover {
    -unity-background-image-tint-color: rgba(217, 175, 83, 0.11);
    color: rgba(236, 170, 79, 0.8);
    background-color: rgba(255, 255, 255, 0.36);
}

.unity-slider:focus .unity-base-slider__label {
    color: rgba(236, 170, 79, 0.8);
}

.unity-toggle:focus .unity-toggle__label {
    color: rgba(236, 170, 79, 0.8);
}

.unity-toggle__checkmark {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 446px;
    border-top-right-radius: 446px;
    border-bottom-right-radius: 446px;
    border-bottom-left-radius: 446px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgb(255, 255, 255);
    -unity-text-align: upper-left;
    white-space: pre;
    text-overflow: clip;
    justify-content: space-between;
    align-self: center;
    align-content: flex-start;
    align-items: stretch;
    background-size: 75% 75%;
    max-height: 60px;
    max-width: 60px;
}

.unity-toggle__input {
    background-size: 30% 100%;
}
